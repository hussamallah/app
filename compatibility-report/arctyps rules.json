      "rules": {
        "domains": { "O": "Low", "C": "High", "E": "Medium", "A": "High", "N": "High" },
        "facet_clusters": {
          "O": { "any_low": ["Adventurousness", "Liberalism"] },
          "C": { "min_high": 2, "facets": ["Dutifulness", "Self-Discipline"] },
          "A": { "min_high": 3, "facets": ["Trust", "Morality", "Cooperation"] },
