      "id": "spotlight",
      "gz": "Spotlight",
      "color": { "name": "Golden yellow", "hex": "#EAB308" },
      "rules": {
        "domains": { "O": "Medium", "C": "Low", "E": "High", "A": "Medium", "N": "High" },
        "facet_clusters": {
          "C": { "any_low": ["Orderliness","Cautiousness","Dutifulness"] },
          "E": { "min_high": 3, "facets": ["Excitement-Seeking","Cheerfulness","Gregariousness","Assertiveness"] },
