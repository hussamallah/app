        }
      }
    }
  ],
  "tie_layer": {
    "version": "v4",
    "mode": "binary_brackets_4",
    "group_size": 3,
    "no_repeat_in_round": true,
    "bye_policy": "auto",
    "max_rounds": null,
    "triad_templates": [
      {
        "id": "lead_style",
        "when_candidates_any": ["sovereign","guardian","spotlight"],
        "question": "When leading, what do you rely on first?",
        "hints": {
          "sovereign": "Rules and structure",
          "guardian": "Safety and protection",
          "spotlight": "Energy and visibility"
        }
      },
      {
        "id": "change_drive",
        "when_candidates_any": ["rebel","catalyst","visionary"],
        "question": "What drives you to change things?",
        "hints": {
          "rebel": "Breaking restrictions",
          "catalyst": "Igniting pure motion",
          "visionary": "Imagining the future"
        }
      },
      {
        "id": "care_mode",
        "when_candidates_any": ["provider","diplomat","vessel"],
        "question": "Your approach to helping others is:",
        "hints": {
          "provider": "Supplying what is needed",
          "diplomat": "Mediating conflict",
          "vessel": "Creating a peaceful space"
        }
      },
      {
        "id": "work_style",
        "when_candidates_any": ["architect","navigator","seeker"],
        "question": "How do you solve complex problems?",
        "hints": {
          "architect": "Building a solid framework",
          "navigator": "Adapting as you go",
          "seeker": "Digging for the hidden truth"
        }
      }
    ],
    "binary_templates": [
      {
        "axis": "C_vs_E",
        "question": "In a crunch, what’s your first move?",
        "left_bucket": "C",
        "left_hint": "Impose order and standards",
        "right_bucket": "E",
        "right_hint": "Rally people and drive action"
      },
      {
        "axis": "A_vs_O",
        "question": "How do you connect with others?",
        "left_bucket": "A",
        "left_hint": "Through shared values and duty",
        "right_bucket": "O",
        "right_hint": "Through ideas and exploration"
      },
      {
        "axis": "E_vs_N",
        "question": "Under pressure, how do you react?",
        "left_bucket": "E",
        "left_hint": "Engage and confront",
        "right_bucket": "N",
        "right_hint": "Assess risks and worry"
      },
      {
        "axis": "C_vs_O",
        "question": "What do you trust more?",
        "left_bucket": "C",
        "left_hint": "Proven systems",
        "right_bucket": "O",
        "right_hint": "New possibilities"
      }
    ],
    "fallbacks": {
      "triad_question": "Which description fits you best?",
      "binary_question": "Which feels more like you?"
    }
  }
}