          "E": { "any_low": ["Excitement-Seeking", "Gregariousness"] },
          "A": { "any_low": ["Sympathy", "Modesty"] },
          "N": { "any_low": ["Immoderation", "Vulnerability", "Anxiety"] }
        }
      }
    },
