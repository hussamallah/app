{
  "version": "gz_archetype_rules.v4_complete_profiles",
  "buckets": { "low": 0.25, "high": 0.75 },
  "domains": {
    "O": { "label": "Openness", "facets": ["Imagination","Artistic Interests","Emotionality","Adventurousness","Intellect","Liberalism"] },
    "C": { "label": "Conscientiousness", "facets": ["Orderliness","Dutifulness","Achievement","Self-Discipline","Cautiousness","Self-Efficacy"] },
    "E": { "label": "Extraversion", "facets": ["Friendliness","Gregariousness","Assertiveness","Activity Level","Excitement-Seeking","Cheerfulness"] },
    "A": { "label": "Agreeableness", "facets": ["Trust","Morality","Altruism","Cooperation","Modesty","Sympathy"] },
    "N": { "label": "Neuroticism", "facets": ["Anxiety","Anger","Depression","Self-Consciousness","Immoderation","Vulnerability"] }
  },
  "operators": {
    "require": "all listed facets must meet the stated bucket",
    "min_high": "at least N of listed facets are High",
    "any_high": "at least one listed facet is High",
    "any_low": "at least one listed facet is Low"
  },
  "archetypes": [
    {
      "id": "sovereign",
      "gz": "Sovereign",
      "color": { "name": "Royal violet", "hex": "#6D28D9" },
      "rules": {
        "domains": { "O": "Low", "C": "High", "E": "High", "A": "Low", "N": "Low" },
        "facet_clusters": {
          "O": { "any_low": ["Liberalism", "Imagination"] },
          "C": { "min_high": 3, "facets": ["Orderliness","Achievement","Self-Efficacy","Dutifulness"] },
          "E": { "min_high": 2, "facets": ["Assertiveness","Activity Level"] },
          "A": { "any_low": ["Modesty", "Sympathy", "Cooperation"] },
          "N": { "any_low": ["Vulnerability", "Anxiety"] }
        }
      }
    },
    {
      "id": "rebel",
      "gz": "Rebel",
      "color": { "name": "Fiery orange", "hex": "#FF6A00" },
      "rules": {
        "domains": { "O": "High", "C": "Low", "E": "High", "A": "Low", "N": "Medium" },
        "facet_clusters": {
          "O": { "min_high": 3, "facets": ["Liberalism","Adventurousness","Imagination"] },
          "C": { "any_low": ["Orderliness", "Dutifulness", "Cautiousness"] },
          "E": { "any_high": ["Assertiveness", "Excitement-Seeking"] },
          "A": { "min_high": 2, "facets": ["Morality","Cooperation","Modesty"], "bucket": "Low" },
          "N": { "any_high": ["Anger", "Immoderation"] }
        }
      }
    },
    {
      "id": "visionary",
      "gz": "Visionary",
      "color": { "name": "Indigo", "hex": "#4338CA" },
