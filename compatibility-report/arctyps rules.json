        "domains": { "O": "High", "C": "Low", "E": "High", "A": "Medium", "N": "High" },
        "facet_clusters": {
          "O": { "min_high": 3, "facets": ["Imagination","Intellect","Artistic Interests"] },
          "C": { "any_low": ["Orderliness", "Self-Discipline", "Cautiousness"] },
          "E": { "any_high": ["Activity Level", "Assertiveness"] },
          "N": { "any_high": ["Anxiety", "Vulnerability"] }
        }
      }
    },
