        "facet_clusters": {
          "C": { "min_high": 2, "facets": ["Dutifulness", "Orderliness"] },
          "E": { "any_high": ["Friendliness", "Activity Level"] },
          "A": { "min_high": 3, "facets": ["Altruism","Cooperation","Sympathy"] }
        }
      }
    },
    {
      "id": "catalyst",
      "gz": "Catalyst",
      "color": { "name": "Electric Lime", "hex": "#84CC16" },
